{
  "name": "@local/dsh-model-debate",
  "version": "1.2.0",
  "description": "Evidence-first multi-model debate workspace for DeepSeek Harness",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Mhmd7-7/dsh-model-debate.git" },
  "homepage": "https://github.com/Mhmd7-7/dsh-model-debate#readme",
  "bugs": { "url": "https://github.com/Mhmd7-7/dsh-model-debate/issues" },
  "engines": { "node": ">=22", "dsh": "0.2.1-rc.2" },
  "exports": { ".": "./dist/index.js", "./client": "./dist/client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["dist", "src", "scripts", "tests", "tsconfig.json", "locale", "icon.svg", "cordis.patch.yml", "README.md", "docs", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-layout"] }
  },
  "scripts": { "build": "node scripts/build.mjs", "typecheck": "tsc --noEmit", "test": "tsx --test tests/*.test.ts", "check": "npm run typecheck && npm test && npm run build", "smoke": "tsx scripts/smoke.ts" },
  "dependencies": { "zod": "4.4.3", "@deepseek-ai/schemastery": "3.18.5" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/react": "^19.0.0", "esbuild": "^0.25.0", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
